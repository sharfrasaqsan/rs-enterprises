rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.role == 'owner';
    }

    function isStaff() {
      return isAuthenticated() && (request.auth.token.role == 'staff' || request.auth.token.role == 'owner');
    }

    // Vehicle photography: public read, staff upload/update
    match /vehicles/{vehicleId}/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff()
                   && request.resource.size < 10 * 1024 * 1024 // Max 10MB per image
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isStaff();
    }

    // Confidential auction inspection sheets and customs clearance docs: staff/owner only
    match /documents/{vehicleId}/{fileName} {
      allow read: if isStaff();
      allow write: if isStaff()
                   && request.resource.size < 20 * 1024 * 1024; // Max 20MB per document
      allow delete: if isOwner();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

